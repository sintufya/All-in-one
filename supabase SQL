create table users (
  id bigint generated by default as identity primary key,
  phone text unique,
  name text,
  is_supplier boolean default false
);

create table products (
  id bigint generated by default as identity primary key,
  owner_id bigint references users(id),
  title text,
  base_price float,
  image_url text,
  is_resellable boolean default false,
  created_at timestamp default now()
);

create table resell_sales (
  id bigint generated by default as identity primary key,
  product_id bigint references products(id),
  reseller_id bigint references users(id),
  final_price float,
  markup float,
  status text default 'pending',
  created_at timestamp default now()
);

create table orders (
  id bigint generated by default as identity primary key,
  sale_id bigint references resell_sales(id),
  product_id bigint references products(id),
  buyer_phone text,
  amount float,
  status text default 'pending',
  mpesa_checkout_id text,
  mpesa_receipt text,
  created_at timestamp default now()
);

insert into storage.buckets (id, name, public) values ('products', 'products', true);

create function get_weekly_leaderboard(week_ago timestamp)
returns table (id bigint, name text, sales_count bigint, total_earnings float)
language sql
as $$
  select u.id, u.name, count(rs.id) as sales_count, sum(rs.markup) as total_earnings
  from resell_sales rs
  join users u on u.id = rs.reseller_id
  where rs.created_at >= week_ago and rs.status = 'paid'
  group by u.id, u.name
  order by sum(rs.markup) desc
  limit 10;
$$;